# Nunca completar estos valores acá — usar `wrangler pages secret put <NOMBRE>`
# para los secretos reales. Este archivo es solo documentación de qué
# variables existen; .env* está en .gitignore y no se commitea.

# Proveedor de imágenes de producto
PRODUCT_IMAGE_PROVIDER=barcode_lookup

# Barcode Lookup API v3 (https://www.barcodelookup.com/api) — SECRETO,
# nunca en el código ni en el frontend. Setear con:
#   wrangler pages secret put BARCODE_LOOKUP_API_KEY --project-name=catalogo-farmacias-global
BARCODE_LOOKUP_API_KEY=
BARCODE_LOOKUP_DAILY_LIMIT=100

# Normalización de imágenes
PRODUCT_IMAGE_MAX_SIZE_MB=10
PRODUCT_IMAGE_MIN_WIDTH=600
PRODUCT_IMAGE_MIN_HEIGHT=600

# Cloudflare Access (protege /admin/*) — no son secretos (viajan en el
# JWT firmado igual), pero tampoco están hardcodeados en el código.
# Ver wrangler.toml [vars] y el README para cómo obtenerlos.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
